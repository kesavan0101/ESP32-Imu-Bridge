<launch>
    <node pkg="esp32_imu_bridge" exec="imu_node" >
        <param name="port" value="/dev/ttyUSB2"/>
        <param name="baudrate" value="115200"/>
    </node> 

    <node pkg="imu_filter_madgwick" exec="imu_filter_madgwick_node" name="imu_filter_madgwick_node" output="screen">
        <param name="use_mag" value="false"/>
        <param name="publish_tf" value="true"/>
        <param name="fixed_frame" value="odom"/>
        <remap from="/imu/data_raw" to="/imu/data_raw"/>
        <remap from="/imu/data" to="/imu/data_filtered"/>
    </node>

    <let name="urdf_path" value="$(find-pkg-share esp32_imu_bridge)/urdf/my_plane.urdf.xacro"/>
    <node pkg="robot_state_publisher" exec="robot_state_publisher" name="robot_state_publisher" output="screen">
        <param name="robot_description" value="$(command 'xacro $(var urdf_path)')"/>
    </node>

    <node pkg="joint_state_publisher" exec="joint_state_publisher" />

    <!-- Connects imu_link directly to your plane's base_footprint replaceing the floating axis with actual model -->
    <node pkg="tf2_ros" exec="static_transform_publisher" 
          args="0 0 0 0 0 0 imu_link base_footprint"/>

    <let name="rviz_config_path" value="$(find-pkg-share esp32_imu_bridge)/rviz/urdf_config.rviz"/>
    <node pkg="rviz2" exec="rviz2" name="rviz2" output="screen" 
            args="-d $(var rviz_config_path)"/>
</launch>